session Rust = Main +
  options [timeout = 600]
  theories
    Rust_Setup

session Test in "@TEST_DIR@" = Rust +
  description "@TEST_THEORY@ test session"
  options [timeout = 300]
  sessions
    "HOL-Library"
  theories [document = false]
    "@TEST_THEORY@"
  export_files (in "stage1/@TEST_THEORY@") [2]
    "*:**.rs"
    "*:**.toml"
