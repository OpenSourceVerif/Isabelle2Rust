+                                (Arith.times_nat
+                                  (Arith.Nat_of_num (Arith.Bit0 Arith.One)) n)
+                                (Arith.Nat_of_num (Arith.Bit0 Arith.One))))
+                else (if Arith.less_eq_nat len
