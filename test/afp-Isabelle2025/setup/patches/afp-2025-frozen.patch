+structure BinaryTree_TacticStyle_Code : sig
+  type nat
+  type num
+  type tree
+  val test : bool
+end = struct
+
+datatype nat = Zero_nat | Suc of nat;
+
+datatype num = One | Bit0 of num | Bit1 of num;
+
+datatype tree = Tip | Nd of tree * nat * tree;
+
+fun plus_nat (Suc m) n = plus_nat m (Suc n)
+  | plus_nat Zero_nat n = n;
+
+val one_nat : nat = Suc Zero_nat;
+
+fun nat_of_num (Bit1 n) = let
+                            val m = nat_of_num n;
+                          in
+                            Suc (plus_nat m m)
+                          end
+  | nat_of_num (Bit0 n) = let
+                            val m = nat_of_num n;
+                          in
+                            plus_nat m m
+                          end
+  | nat_of_num One = one_nat;
+
+fun equal_nat Zero_nat (Suc x2) = false
+  | equal_nat (Suc x2) Zero_nat = false
+  | equal_nat (Suc x2) (Suc y2) = equal_nat x2 y2
+  | equal_nat Zero_nat Zero_nat = true;
+
+fun equal_tree Tip (Nd (x21, x22, x23)) = false
+  | equal_tree (Nd (x21, x22, x23)) Tip = false
+  | equal_tree (Nd (x21, x22, x23)) (Nd (y21, y22, y23)) =
+    equal_tree x21 y21 andalso (equal_nat x22 y22 andalso equal_tree x23 y23)
+  | equal_tree Tip Tip = true;
+
+fun rm (Nd (l, x, r)) = (if equal_tree r Tip then x else rm r);
+
+fun less_nat m (Suc n) = less_eq_nat m n
+  | less_nat n Zero_nat = false
+and less_eq_nat (Suc m) n = less_nat m n
+  | less_eq_nat Zero_nat n = true;
+
+fun rem (Nd (l, x, r)) = (if equal_tree r Tip then l else Nd (l, x, rem r));
+
+fun memb e Tip = false
+  | memb e (Nd (t1, x, t2)) =
+    (if less_nat e x then memb e t1
+      else (if less_nat x e then memb e t2 else true));
+
+fun binsert x Tip = Nd (Tip, x, Tip)
+  | binsert x (Nd (t1, y, t2)) =
+    (if less_nat x y then Nd (binsert x t1, y, t2)
+      else (if less_nat y x then Nd (t1, y, binsert x t2) else Nd (t1, y, t2)));
+
+fun remove x Tip = Tip
+  | remove x (Nd (l, y, r)) =
+    (if less_nat x y then Nd (remove x l, y, r)
+      else (if less_nat y x then Nd (l, y, remove x r)
+             else (if equal_tree l Tip then r else Nd (rem l, rm l, r))));
+
+val test : bool =
+  memb (nat_of_num (Bit0 (Bit0 One)))
+    (remove (nat_of_num (Bit1 One))
+      (binsert (nat_of_num (Bit0 (Bit0 One)))
+        (binsert (nat_of_num (Bit1 One)) Tip)));
+
+end; (*struct BinaryTree_TacticStyle_Code*)
