+                 (Arith.times_nat (Arith.Nat_of_num (Arith.Bit0 Arith.One))
+                   (Arith.minus_nat n (Arith.Nat_of_num Arith.One)))
+                 (Arith.Nat_of_num (Arith.Bit0 Arith.One)))]);
